#!/usr/bin/bash
#
# Launch Google Chrome with full GPU offload / hardware rendering.
# Required for Google Meets to not eat CPU / software rendering mode
# The following options need to be enabled in chrome://flags
#  #ignore-gpu-blocklist, #enable-zero-copy, #enable-unsafe-webgpu, #enable-vulkan
#
# --password-store=basic stops the GNOME keyring prompts, but Chrome's saved secrets then use a fixed key
/usr/bin/google-chrome-stable --enable-features=VaapiVideoDecoder,VaapiVideoEncoder --password-store=basic --use-mock-keychain
