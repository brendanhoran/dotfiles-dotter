# Launch apps needed to support desktop usability
#
# Polkit agent
exec /usr/libexec/polkit-gnome-authentication-agent-1

# Desktop notification agent
exec /usr/bin/mako

# Network manager agent
exec /usr/bin/nm-applet

# Mousepad to act as a text scratchpad
exec /usr/bin/mousepad

# Start kanshi display manager.
# kanshi is a long-running daemon: it applies the profile matching the
# currently connected outputs, then stays up to auto-switch on dock/undock.
# Use exec (runs once at startup)
exec kanshi
